---
import AppLayout from '@/layouts/AppLayout.astro';
import AppHeader from '@/components/AppHeader.astro';
// import AppTicker from '@/components/AppTicker.astro';
import KuaixunSection from '@/components/home/KuaixunSection.astro';
import EditorialSection from '@/components/home/EditorialSection.astro';
import LiveFeedSection from '@/components/home/LiveFeedSection.astro';
import type { LiveItem } from '@/data/static-home';
import { fetchOstayRecent, fetchOstayBlogArticles } from '@/lib/ostay-api';
import { fetchXTimelines } from '@/lib/proxy-api';
import { encryptText } from '@/lib/aes';
import { sourceDisplayName, timeAgo } from '@/lib/format';
import { proxyImageUrl } from '@/lib/img-proxy';

const aesKey = process.env.AES_SECRET_KEY ?? '';

// 實時動態
let liveItems: LiveItem[] = [];
let liveUpdatedAgo = '';
let liveUpdatedAt = '';

try {
  const { data } = await fetchXTimelines(process.env.API_AUTH_TOKEN ?? '', { pageSize: 10 });
  if (data.items.length > 0 && data.items[0].created_at) {
    liveUpdatedAt = data.items[0].created_at;
    liveUpdatedAgo = timeAgo(liveUpdatedAt);
  }
  liveItems = await Promise.all(
    data.items.slice(0, 7).map(async (item): Promise<LiveItem> => {
      const ageH = (Date.now() - new Date(item.created_at ?? '').getTime()) / 3600000;
      const text = item.note_tweet?.text ?? item.text ?? '';
      return {
        status: ageH < 1 ? 'new' : ageH < 3 ? 'recent' : 'old',
        type: 'tweet',
        source: '@' + (item.author?.username ?? ''),
        title: await encryptText(text, aesKey),
        timeAgo: timeAgo(item.created_at),
        dateValue: item.created_at ?? undefined,
        href: `/x/posts/${item.id}`,
      };
    })
  );
} catch {
  // fall back to empty list
}

// 今日最新
let recentItems: { rank: number; title: string; source: string; timeAgo: string; dateValue?: string; href: string; imageUrl: string | null }[] = [];
let recentError: string | null = null;

try {
  const { data } = await fetchOstayRecent(24);
  recentItems = await Promise.all(
    data.items.slice(0, 7).map(async (item, i) => ({
      rank: i + 1,
      title: await encryptText(item.title, aesKey),
      source: sourceDisplayName(item.source),
      timeAgo: timeAgo(item.publishedAt ?? item.createdAt),
      dateValue: item.publishedAt ?? item.createdAt ?? undefined,
      href: `/content/${item.source}/${item.sourceItemId}`,
      imageUrl: proxyImageUrl(item.imageUrl, item.source),
    }))
  );
} catch (e) {
  recentError = e instanceof Error ? e.message : String(e);
}

// 編輯精選
type EditorialItem = { type: 'header' | 'article' | 'video'; title: string; sourceName: string | null; imageUrl: string | null; href: string | null };
let editorialItems: EditorialItem[] = [];
let editorialDate = '';
let editorialDateValue = '';
let editorialError: string | null = null;

try {
  const { data } = await fetchOstayBlogArticles();
  const edition = data.find((candidate) => candidate.items.length > 0) ?? null;
  if (edition) {
    const d = new Date(edition.date);
    editorialDate = `${d.getMonth() + 1}月${d.getDate()}日`;
    editorialDateValue = edition.date;
    editorialItems = await Promise.all(
      edition.items.map(async (item): Promise<EditorialItem> => {
        if (!item.id || !item.source) {
          return { type: 'header', title: item.title, sourceName: null, imageUrl: null, href: null };
        }
        const encTitle = await encryptText(item.title, aesKey);
        return {
          type: item.contentType === 'video' ? 'video' : 'article',
          title: encTitle,
          sourceName: item.sourceName,
          imageUrl: proxyImageUrl(item.imageUrl, item.source),
          href: `/content/${item.source}/${item.id}`,
        };
        })
    );
  }
} catch (e) {
  editorialError = e instanceof Error ? e.message : String(e);
}

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=180, stale-while-revalidate=60');
---

<AppLayout title="首頁" activeTab="home">
  <div class="sticky top-0 z-40">
    <AppHeader />
    {/* <AppTicker /> */}
  </div>

  <!-- Mobile: single column. Desktop: main + right sidebar -->
  <div class="flex-1 flex overflow-hidden">

    <!-- Main feed -->
    <main class="flex-1 overflow-y-auto pb-2 min-w-0">
      {recentError
        ? <p class="px-4 py-6 text-sm text-error">{recentError}</p>
        : <KuaixunSection items={recentItems} />
      }
      <EditorialSection items={editorialItems} date={editorialDate} dateValue={editorialDateValue} error={editorialError} />
      <!-- Live feed shown inline on mobile -->
      <div class="lg:hidden">
        <LiveFeedSection items={liveItems} updatedAgo={liveUpdatedAgo || '剛剛'} updatedAt={liveUpdatedAt} />
      </div>
    </main>

    <!-- Right sidebar: desktop only -->
    <aside class="hidden lg:block lg:w-72 lg:shrink-0 lg:overflow-y-auto lg:border-l lg:border-base-300 lg:bg-base-100">
        <LiveFeedSection items={liveItems} updatedAgo={liveUpdatedAgo || '剛剛'} updatedAt={liveUpdatedAt} />
    </aside>

  </div>
</AppLayout>
