---
import type { LiveItem } from '@/data/static-home';

interface Props {
  items: LiveItem[];
  updatedAgo?: string;
  updatedAt?: string;
}

const { items, updatedAgo = '5分鐘前', updatedAt } = Astro.props;

const typeLabel: Record<LiveItem['type'], string> = {
  article: '文章',
  tweet: 'X',
};
---

<section class="px-3 pt-4 pb-4">
  <div class="flex items-center justify-between mb-2">
    <span class="text-sm font-bold text-base-content/70 uppercase tracking-wider">實時動態</span>
    <div class="flex items-center gap-3">
      <span class="text-sm text-base-content/50" data-local-relative={updatedAt}>{updatedAgo}</span>
      <a href="/x" class="text-sm text-primary font-semibold">更多 →</a>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="divide-y divide-base-200">
      {items.map((item) => (
        <a
          href={item.href}
          class="flex items-start gap-2.5 px-4 py-3 hover:bg-base-200/50 transition-colors"
        >
          <div class="pt-1.5 shrink-0">
            <span class="block w-1.5 h-1.5 rounded-full bg-base-content/20" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[15px] font-semibold leading-snug text-base-content line-clamp-2" data-enc>{item.title}</p>
            <div class="flex items-center gap-1.5 mt-1 text-xs text-base-content/50">
              <span>{typeLabel[item.type]}</span>
              <span>{item.source}</span>
              <span data-local-relative={item.dateValue}>{item.timeAgo}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .dot-pulse {
    animation: dot-pulse 1.5s infinite;
  }
  @keyframes dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.8); }
  }
</style>
