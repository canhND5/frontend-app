---
/**
 * Card grid for proxy-backed video items.
 */
import type { ProxyListItem } from "@/lib/proxy-api";
import { buildContentHref, formatDateLabel, formatDurationLabel } from "@/lib/proxy-utils";

interface Props {
	items: ProxyListItem[];
	source: string;
}

const { items, source } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-5">
	{items.map((item) => (
		<a
			href={buildContentHref(source, item.sourceItemId, {
				kind: item.contentType ?? "video",
				posterUrl: item.imageUrl,
			})}
			class="group overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-[0_18px_50px_rgba(41,37,36,0.06)] transition hover:-translate-y-1 hover:border-amber-600 hover:shadow-[0_24px_70px_rgba(41,37,36,0.12)]"
		>
			<div class="aspect-[3/4] overflow-hidden bg-stone-200">
				{item.imageUrl ? (
					<img
						src={item.imageUrl}
						alt={item.title}
						loading="lazy"
						class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
					/>
				) : (
					<div class="flex h-full items-center justify-center bg-stone-200 text-sm text-stone-500">
						No poster
					</div>
				)}
			</div>
			<div class="space-y-3 p-4">
				<div class="flex items-center justify-between gap-2 text-[14px] uppercase tracking-[0.24em] text-stone-500">
					<span>{item.contentType ?? "video"}</span>
					<span>{formatDurationLabel(item.duration)}</span>
				</div>
				<h3 class="line-clamp-3 text-sm font-semibold leading-6 text-stone-950">
					{item.title}
				</h3>
				<p class="text-xs text-stone-500" data-local-date={item.publishedAt ?? item.pubDate}>{formatDateLabel(item.publishedAt ?? item.pubDate)}</p>
			</div>
		</a>
	))}
</div>
