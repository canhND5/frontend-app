---
/**
 * Auth wall displayed on content pages when the mock auth cookie is absent.
 */
import { DOG_WALL_IMAGE } from "@/lib/proxy-utils";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "This proxy demo keeps all real Pocket CMS content behind the mock auth cookie. Login to unlock the live lists and detail pages.",
} = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 py-12 sm:py-20">
	<div class="grid overflow-hidden rounded-4xl border border-white/10 bg-white/5 shadow-2xl shadow-black/30 lg:grid-cols-[1.1fr_0.9fr]">
		<div class="flex flex-col justify-center gap-6 p-8 sm:p-10">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-300/80">
				Mock Auth Required
			</p>
			<div class="space-y-4">
				<h1 class="font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					{title}
				</h1>
				<p class="max-w-2xl text-base leading-7 text-slate-300">
					{description}
				</p>
			</div>
			<div class="flex flex-wrap gap-3">
				<a
					href="/login"
					class="inline-flex items-center rounded-full bg-amber-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-300"
				>
					Set Mock Auth Cookie
				</a>
			</div>
		</div>
		<div class="relative min-h-80 bg-slate-950">
			<img
				src={DOG_WALL_IMAGE}
				alt="A friendly golden retriever waiting behind the proxy demo auth wall."
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/45 to-transparent" />
			<div class="absolute bottom-0 left-0 right-0 p-6 text-sm text-slate-200">
				Dog mode is active until the demo cookie is set.
			</div>
		</div>
	</div>
</section>
