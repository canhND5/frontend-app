---
/**
 * Simple article list used across homepage and list pages.
 */
import type { ProxyListItem } from "@/lib/proxy-api";
import { buildContentHref, formatDateLabel } from "@/lib/proxy-utils";

interface Props {
	items: ProxyListItem[];
	source: string;
}

const { items, source } = Astro.props;
---

<div class="space-y-4">
	{items.map((item, index) => (
		<a
			href={buildContentHref(source, item.sourceItemId, {
				kind: item.contentType ?? "article",
				posterUrl: item.imageUrl,
			})}
			class="grid gap-4 rounded-3xl border border-stone-200 bg-white p-4 shadow-[0_18px_50px_rgba(41,37,36,0.06)] transition hover:-translate-y-0.5 hover:border-amber-600 hover:shadow-[0_24px_70px_rgba(41,37,36,0.12)] sm:grid-cols-[auto_1fr]"
		>
			<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-stone-900 text-sm font-semibold text-stone-50">
				{`${index + 1}`.padStart(2, "0")}
			</div>
			<div class="space-y-2">
				<div class="flex flex-wrap items-center gap-2 text-[14px] uppercase tracking-[0.24em] text-stone-500">
					<span>{item.contentType ?? "article"}</span>
					<span class="text-stone-300">/</span>
					<span data-local-date={item.publishedAt ?? item.pubDate}>{formatDateLabel(item.publishedAt ?? item.pubDate)}</span>
				</div>
				<h3 class="text-base font-semibold leading-7 text-stone-950">{item.title}</h3>
				{item.summary && (
					<p class="line-clamp-2 text-sm leading-6 text-stone-600">
						{item.summary}
					</p>
				)}
			</div>
		</a>
	))}
</div>
