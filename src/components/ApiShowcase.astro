---
/**
 * Compact route-family list for the homepage API coverage section.
 */
import type { ApiShowcaseGroup } from "@/data/api-showcase";

interface Props {
	groups: ApiShowcaseGroup[];
}

const { groups } = Astro.props;
---

<div class="grid gap-4 lg:grid-cols-2">
	{groups.map((group) => (
		<section class="rounded-3xl border border-stone-200 bg-white p-5 shadow-[0_20px_60px_rgba(41,37,36,0.08)]">
			<div class="space-y-2">
				<p class="text-xs uppercase tracking-[0.28em] text-stone-500">{group.title}</p>
				<p class="text-sm leading-6 text-stone-600">{group.description}</p>
			</div>
			<div class="mt-4 space-y-3">
				{group.routes.map((route) => (
					<div class="rounded-[1.25rem] border border-stone-200/90 bg-stone-50 px-4 py-3">
						<div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.22em] text-stone-500">
							<span class="rounded-full bg-stone-900 px-2.5 py-1 text-[14px] font-semibold text-stone-50">
								{route.method}
							</span>
							<span>{route.auth === "public" ? "Public" : "Bearer"}</span>
						</div>
						<p class="mt-3 font-mono text-sm text-stone-900">{route.path}</p>
						<p class="mt-2 text-sm leading-6 text-stone-600">{route.purpose}</p>
					</div>
				))}
			</div>
		</section>
	))}
</div>
